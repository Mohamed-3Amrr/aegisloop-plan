{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohamed-3amrr.github.io/aegisloop-plan/handoffs/tasks/C22.schema.json",
  "title": "C22 proposed asset integration packet v1",
  "type": "object",
  "required": [
    "contract_id",
    "schema_version",
    "task_id",
    "producer",
    "revision",
    "mode",
    "data_kind",
    "created_at",
    "records",
    "artifacts",
    "provenance",
    "extensions"
  ],
  "properties": {
    "contract_id": {
      "const": "handoff:C22"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "const": "C22"
    },
    "producer": {
      "const": "Shams"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "reference",
        "delivered"
      ]
    },
    "data_kind": {
      "enum": [
        "public_source_reference",
        "source_backed_scenario",
        "lab_observation",
        "implementation_evidence",
        "evaluation_evidence"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "experiment_id",
          "case_manifest_revision",
          "metrics",
          "denominator",
          "run_state",
          "limitations"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "experiment_id": {
            "type": "string"
          },
          "case_manifest_revision": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          },
          "denominator": {
            "type": [
              "number",
              "null"
            ]
          },
          "run_state": {
            "type": "string"
          },
          "limitations": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "state",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "state": {
            "enum": [
              "not_produced",
              "provided",
              "equivalent_documented"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "equivalent_path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_ids",
        "limitations"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}